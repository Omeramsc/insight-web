      {t.hero.requirements}
    </p>
  </div>
</section>

<script is:inline>
  document.addEventListener('DOMContentLoaded', function () {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    var glow = document.querySelector('.hero-glow');
    var section = document.querySelector('section[aria-labelledby="hero-heading"]');
    if (!glow || !section) return;
    section.addEventListener('pointermove', function (e) {
      var r = section.getBoundingClientRect();
      var x = ((e.clientX - r.left) / r.width) * 100;
      var y = ((e.clientY - r.top) / r.height) * 100;
      glow.style.background =
        'radial-gradient(600px circle at ' + x + '% ' + y + '%, rgba(108,142,255,0.35), transparent 55%)';
    });
    section.addEventListener('pointerleave', function () {
      glow.style.background =
        'radial-gradient(600px circle at 50% 40%, rgba(108,142,255,0.22), transparent 55%)';
    });
    glow.style.background =
      'radial-gradient(600px circle at 50% 40%, rgba(108,142,255,0.22), transparent 55%)';
  });
</script>
</file>

