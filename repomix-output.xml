<file path="src/components/Comparison.astro">
---
import { Check, X, Minus } from 'lucide-astro';
import en from '../i18n/en.json';
import ja from '../i18n/ja.json';

interface Props {
  lang: 'en' | 'ja';
}

const { lang } = Astro.props;
const t = lang === 'ja' ? ja : en;

function cellKind(v: boolean | 'partial') {
  if (v === true) return 'yes' as const;
  if (v === false) return 'no' as const;
  return 'partial' as const;
}
---

<section class="bg-surface py-16 md:py-24" aria-labelledby="compare-heading">
  <div class="mx-auto max-w-7xl px-4 md:px-8 lg:px-16">
    <div class="mx-auto max-w-3xl text-center" data-reveal>
      <h2 id="compare-heading" class="font-display text-3xl font-semibold tracking-tight text-text-primary md:text-4xl">
        {t.comparison.title}
      </h2>
      <p class="mt-4 text-lg text-text-secondary">{t.comparison.subtitle}</p>
    </div>

    <div class="mt-12 overflow-x-auto rounded-2xl border border-border bg-surface-2" data-reveal>
      <table class="w-full min-w-[640px] border-collapse text-left text-sm">
        <caption class="sr-only">{t.comparison.title}</caption>
        <thead>
          <tr class="border-b border-border">
            <th scope="col" class="px-4 py-4 font-display font-semibold text-text-primary md:px-6">
              {t.comparison.feature}
            </th>
            <th scope="col" class="px-4 py-4 font-display font-semibold text-text-secondary md:px-6">
              {t.comparison.adobe}
            </th>
            <th scope="col" class="px-4 py-4 font-display font-semibold text-text-secondary md:px-6">
              {t.comparison.otherPlugins}
            </th>
            <th scope="col" class="px-4 py-4 font-display font-semibold text-accent md:px-6">
              {t.comparison.insight}
            </th>
          </tr>
        </thead>
        <tbody>
          {t.comparison.rows.map((row) => (
            <tr class="border-b border-border/80 last:border-0">
              <th scope="row" class="px-4 py-4 font-medium text-text-primary md:px-6">
                {row.label}
              </th>
              {[row.adobe, row.other, row.insight].map((v) => {
                const kind = cellKind(v as boolean | 'partial');
                return (
                  <td class="px-4 py-4 md:px-6">
                    <span class="inline-flex items-center gap-2">
                      {kind === 'yes' ? (
                        <>
                          <Check class="h-5 w-5 text-emerald-400" aria-hidden="true" />
                          <span class="sr-only">{t.comparison.yes}</span>
                        </>
                      ) : kind === 'no' ? (
                        <>
                          <X class="h-5 w-5 text-text-muted" aria-hidden="true" />
                          <span class="sr-only">{t.comparison.no}</span>
                        </>
                      ) : (
                        <>
                          <Minus class="h-5 w-5 text-amber-300" aria-hidden="true" />
                          <span class="sr-only">{t.comparison.partial}</span>
                        </>
                      )}
                    </span>
                  </td>
                );
              })}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>
</section>
</file>

<file path="src/components/DemoVideo.astro">
---
import en from '../i18n/en.json';
import ja from '../i18n/ja.json';

interface Props {
  lang: 'en' | 'ja';
}

const { lang } = Astro.props;
const t = lang === 'ja' ? ja : en;
const videoId = t.urls.youtubeId;
const hasRealVideo = Boolean(videoId && videoId !== 'YOUR_VIDEO_ID');
const poster = '/assets/hero-bg.png';
---

<section id="demo" aria-label={t.demo.sectionLabel} class="py-16 md:py-24">
  <div class="mx-auto max-w-7xl px-4 md:px-8 lg:px-16">
    <div class="mx-auto max-w-3xl text-center" data-reveal>
      <h2 class="font-display text-3xl font-semibold tracking-tight text-text-primary md:text-4xl">
        {t.demo.title}
      </h2>
      <p class="mt-4 text-lg text-text-secondary">{t.demo.subtitle}</p>
    </div>

    <div class="relative mx-auto mt-12 max-w-4xl" data-reveal>
      {hasRealVideo ? (
        <div class="relative aspect-video overflow-hidden rounded-xl border border-border bg-surface-2">
          <button
            type="button"
            class="video-poster group absolute inset-0 z-10 flex flex-col items-center justify-center gap-3 bg-ink/40 text-text-primary backdrop-blur-sm transition hover:bg-ink/50 focus:outline-none focus:ring-2 focus:ring-accent focus:ring-offset-2 focus:ring-offset-ink"
            data-video-start
            aria-label={t.demo.play}
          >
            <img src={poster} alt="" class="absolute inset-0 h-full w-full object-cover opacity-60" width="1600" height="900" loading="lazy" />
            <span class="relative z-10 inline-flex h-16 w-16 items-center justify-center rounded-full bg-accent text-ink shadow-lg">
              <svg aria-hidden="true" class="ml-1 h-7 w-7" viewBox="0 0 24 24" fill="currentColor">
                <path d="M8 5v14l11-7L8 5z"></path>
              </svg>
            </span>
            <span class="relative z-10 text-sm font-semibold">{t.demo.play}</span>
          </button>
          <iframe
            data-video-frame
            title={t.demo.iframeTitle}
            class="absolute inset-0 hidden h-full w-full"
            width="960"
            height="540"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
            allowfullscreen
            loading="lazy"
          />
        </div>
      ) : (
        <div class="relative aspect-video overflow-hidden rounded-xl border border-dashed border-border bg-surface-2 p-8 text-center">
          <p class="text-text-secondary">
            Replace <code class="font-mono text-accent">YOUR_VIDEO_ID</code> in{' '}
            <code class="font-mono text-accent">src/i18n/{lang}.json</code> (or overrides) to embed your YouTube demo.
          </p>
        </div>
      )}
    </div>
  </div>
</section>

{hasRealVideo && (
  <script is:inline define:vars={{ videoId, iframeTitle: t.demo.iframeTitle }}>
    document.addEventListener('DOMContentLoaded', function () {
      var btn = document.querySelector('[data-video-start]');
      var frame = document.querySelector('[data-video-frame]');
      if (!btn || !frame) return;
      btn.addEventListener('click', function () {
        frame.src = 'https://www.youtube.com/embed/' + videoId + '?autoplay=1&rel=0';
        frame.title = iframeTitle;
        frame.classList.remove('hidden');
        btn.classList.add('hidden');
      });
    });
  </script>
)}
</file>

