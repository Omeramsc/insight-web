---
import { Box, Layers, SunMedium } from 'lucide-astro';
import en from '../i18n/en.json';
import ja from '../i18n/ja.json';

interface Props {
  lang: 'en' | 'ja';
}

const { lang } = Astro.props;
const t = lang === 'ja' ? ja : en;

const icons = [Box, Layers, SunMedium];
---

<section class="border-y border-border bg-surface py-16 md:py-24" aria-labelledby="problem-heading">
  <div class="mx-auto max-w-7xl px-4 md:px-8 lg:px-16">
    <div class="mx-auto max-w-2xl text-center mb-12" data-reveal>
      <h2
        id="problem-heading"
        class="font-display text-3xl font-semibold tracking-tight text-text-primary md:text-4xl"
      >
        Sound familiar?
      </h2>
      <p class="mt-4 text-lg text-text-secondary">
        These are the walls every Photoshop photographer hits. Insight was built to break through all three.
      </p>
    </div>
    <div class="grid gap-10 md:grid-cols-3">
      {t.problem.items.map((item, i) => {
        const Icon = icons[i] ?? Box;
        return (
          <div data-reveal class="flex flex-col gap-4 rounded-xl border border-border/80 bg-surface-2/40 p-6">
            <div class="inline-flex h-12 w-12 items-center justify-center rounded-full bg-ink text-accent">
              <Icon class="h-6 w-6" aria-hidden="true" />
            </div>
            <h3 class="font-display text-lg font-semibold text-text-primary">{item.title}</h3>
            <p class="text-base leading-relaxed text-text-secondary">{item.body}</p>
          </div>
        );
      })}
    </div>
  </div>
</section>
