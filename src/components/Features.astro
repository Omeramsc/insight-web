---
import en from '../i18n/en.json';
import ja from '../i18n/ja.json';

interface Props {
  lang: 'en' | 'ja';
}

const { lang } = Astro.props;
const t = lang === 'ja' ? ja : en;

const featureImages = [
  '/assets/feature-1.png',
  '/assets/feature-2.png',
  '/assets/feature-3.png',
  '/assets/feature-4.png',
  '/assets/feature-5.png',
  '/assets/feature-6.png',
  '/assets/feature-7.png'
];
---

<section id="features" class="py-16 md:py-24" aria-labelledby="features-heading">
  <div class="mx-auto max-w-7xl px-4 md:px-8 lg:px-16">
    <div class="mx-auto max-w-3xl text-center" data-reveal>
      <h2 id="features-heading" class="font-display text-3xl font-semibold tracking-tight text-text-primary md:text-4xl">
        {t.features.sectionTitle}
      </h2>
      <p class="mt-4 text-lg text-text-secondary">{t.features.sectionSubtitle}</p>
    </div>

    <div class="mt-16 flex flex-col gap-16 lg:gap-24">
      {t.features.items.map((item, i) => {
        const img = featureImages[i] ?? '/assets/feature-1.png';
        const reverse = i % 2 === 1;
        return (
          <article
            data-reveal
            class:list={[
              'grid items-center gap-10 lg:grid-cols-2 lg:gap-16',
              reverse ? 'lg:[&>div:first-child]:order-2' : '',
            ]}
          >
            <div class="overflow-hidden rounded-2xl border border-border bg-surface-2 shadow-xl shadow-black/30">
              <img src={img} alt={item.imageAlt} width="1200" height="800" loading="lazy" class="h-full w-full object-cover" />
            </div>
            <div class="space-y-4">
              <div class="space-y-2">
                <span class="inline-flex rounded-full border border-accent/30 bg-accent/10 px-3 py-1 text-xs font-semibold uppercase tracking-wider text-accent">
                  {item.badge}
                </span>
                <h3 class="font-display text-2xl font-semibold leading-snug text-text-primary">{item.title}</h3>
              </div>
              <p class="text-base leading-relaxed text-text-secondary">{item.description}</p>
              <ul class="mt-4 space-y-2 text-base text-text-secondary">
                {item.bullets.map((b) => (
                  <li class="flex gap-2">
                    <span class="mt-1.5 h-2 w-2 shrink-0 rounded-full bg-accent" aria-hidden="true" />
                    <span>{b}</span>
                  </li>
                ))}
              </ul>
            </div>
          </article>
        );
      })}
    </div>
  </div>
</section>
