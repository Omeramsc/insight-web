---
import en from '../i18n/en.json';
import ja from '../i18n/ja.json';

interface Props {
  lang: 'en' | 'ja';
}

const { lang } = Astro.props;
const t = lang === 'ja' ? ja : en;
---

<section class="py-16 md:py-24" aria-labelledby="how-heading">
  <div class="mx-auto max-w-7xl px-4 md:px-8 lg:px-16">
    <h2 id="how-heading" class="text-center font-display text-3xl font-semibold tracking-tight text-text-primary md:text-4xl" data-reveal>
      {t.howItWorks.title}
    </h2>
    <div class="relative mt-16 grid gap-12 md:grid-cols-3 md:gap-8">
      <div class="hidden md:block absolute left-[12%] right-[12%] top-8 border-t border-dashed border-border" aria-hidden="true"></div>
      {t.howItWorks.steps.map((step, i) => (
        <div data-reveal class="relative flex flex-col items-center text-center">
          <div class="relative z-10 mb-6 flex h-14 w-14 items-center justify-center rounded-full bg-accent text-lg font-bold text-ink">
            {i + 1}
          </div>
          <h3 class="font-display text-xl font-semibold text-text-primary">{step.title}</h3>
          <p class="mt-3 text-base leading-relaxed text-text-secondary">{step.body}</p>
        </div>
      ))}
    </div>
  </div>
</section>
