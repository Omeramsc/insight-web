---
import en from '../i18n/en.json';
import ja from '../i18n/ja.json';

interface Props {
  lang: 'en' | 'ja';
}

const { lang } = Astro.props;
const t = lang === 'ja' ? ja : en;
---

<section id="faq" class="bg-surface py-16 md:py-24" aria-labelledby="faq-heading">
  <div class="mx-auto max-w-3xl px-4 md:px-8 lg:px-16">
    <h2 id="faq-heading" class="text-center font-display text-3xl font-semibold tracking-tight text-text-primary md:text-4xl" data-reveal>
      {t.faq.title}
    </h2>
    <div class="mt-10 space-y-3">
      {t.faq.items.map((item) => (
        <details
          data-reveal
          class="group rounded-xl border border-border bg-surface-2 px-4 py-3 open:border-accent/40 open:shadow-lg open:shadow-accent/5"
        >
          <summary class="cursor-pointer list-none font-medium text-text-primary focus:outline-none focus:ring-2 focus:ring-accent focus:ring-offset-2 focus:ring-offset-surface [&::-webkit-details-marker]:hidden">
            <span class="flex items-center justify-between gap-4">
              <span>{item.question}</span>
              <span class="text-accent transition group-open:rotate-45" aria-hidden="true">
                +
              </span>
            </span>
          </summary>
          <p class="mt-3 text-sm leading-relaxed text-text-secondary">{item.answer}</p>
        </details>
      ))}
    </div>
  </div>
</section>
