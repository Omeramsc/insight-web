---
import { Check } from 'lucide-astro';
import en from '../i18n/en.json';
import ja from '../i18n/ja.json';

interface Props {
  lang: 'en' | 'ja';
}

const { lang } = Astro.props;
const t = lang === 'ja' ? ja : en;
---

<section id="pricing" class="py-16 md:py-24" aria-labelledby="pricing-heading">
  <div class="mx-auto max-w-7xl px-4 md:px-8 lg:px-16">
    <h2 id="pricing-heading" class="sr-only">
      {t.pricing.title}
    </h2>
    <div class="mx-auto max-w-lg" data-reveal>
      <div class="rounded-2xl border-2 border-accent/60 bg-surface-2 p-8 shadow-xl shadow-black/40 md:p-10">
        <p class="text-center text-xs font-semibold uppercase tracking-[0.2em] text-accent">
          {t.pricing.title}
        </p>
        <div class="my-6 border-t border-border"></div>
        <p class="text-center font-display text-5xl font-bold text-text-primary">{t.pricing.price}</p>
        <p class="mt-2 text-center text-sm text-text-secondary">{t.pricing.subtitle}</p>
        <ul class="mt-8 space-y-3 text-sm text-text-secondary">
          {t.pricing.bullets.map((b) => (
            <li class="flex gap-3">
              <Check class="mt-0.5 h-5 w-5 shrink-0 text-emerald-400" aria-hidden="true" />
              <span>{b}</span>
            </li>
          ))}
        </ul>
        <a
          href={t.urls.gumroad}
          class="mt-10 flex w-full items-center justify-center gap-2 rounded-xl bg-accent py-4 text-center text-base font-semibold text-ink transition hover:brightness-110 focus:outline-none focus:ring-2 focus:ring-accent focus:ring-offset-2 focus:ring-offset-surface-2"
          rel="noopener noreferrer"
          target="_blank"
        >
          {t.pricing.cta}
          <span aria-hidden="true">→</span>
        </a>
        <p class="mt-4 text-center text-xs text-text-muted">{t.pricing.note1}</p>
        <p class="mt-2 text-center text-xs text-text-muted">{t.pricing.note2}</p>
      </div>
    </div>
  </div>
</section>
