---
import Base from '../layouts/Base.astro';
import en from '../i18n/en.json';

const t = en;
---

<Base
  lang="en"
  title={`${t.accessibility.pageTitle} | Insight`}
  description={t.accessibility.metaDescription}
  canonicalPath="/accessibility"
>
  <div class="mx-auto max-w-3xl px-4 py-28 md:px-8 lg:px-16 lg:py-32">
    <article class="max-w-none">
      <h1 class="font-display text-3xl font-bold tracking-tight text-text-primary md:text-4xl">
        {t.accessibility.pageTitle}
      </h1>
      <p class="mt-6 leading-relaxed text-text-secondary">{t.accessibility.intro}</p>
      <h2 class="mt-12 font-display text-xl font-semibold text-text-primary">{t.accessibility.featuresTitle}</h2>
      <ul class="mt-4 list-disc space-y-2 pl-5 text-text-secondary">
        {t.accessibility.features.map((f) => (
          <li>{f}</li>
        ))}
      </ul>
      <h2 class="mt-12 font-display text-xl font-semibold text-text-primary">{t.accessibility.limitationsTitle}</h2>
      <p class="mt-4 leading-relaxed text-text-secondary">{t.accessibility.limitations}</p>
      <h2 class="mt-12 font-display text-xl font-semibold text-text-primary">{t.accessibility.feedbackTitle}</h2>
      <p class="mt-4 leading-relaxed text-text-secondary">
        {t.accessibility.feedback}{' '}
        <a class="font-medium text-accent underline-offset-2 hover:underline" href={`mailto:${t.urls.contactEmail}`}>
          {t.urls.contactEmail}
        </a>
      </p>
      <p class="mt-8 text-sm text-text-muted">{t.accessibility.lastReviewed}</p>
    </article>
  </div>
</Base>
